# Endereco do backend (na rede local, use o IP do computador, ex.: http://192.168.0.10:8000)
VITE_API_URL=http://localhost:8000
# Emulador Android usa 10.0.2.2 para o host: VITE_API_URL=http://10.0.2.2:8000
# Device fisico na mesma Wi-Fi: VITE_API_URL=http://192.168.0.10:8000

# API key opcional para chamadas de escrita (backend/.env -> API_KEY)
# ATENCAO: VITE_* e embutido no bundle dist/APK (visivel). Nunca commitar valor real.
VITE_API_KEY=

# WebSocket usa a mesma origem de VITE_API_URL (ws/wss). Opcional p/ override:
# VITE_WS_URL=ws://192.168.0.10:8000
# Troca em runtime sem rebuild: localStorage 'aquasense.api_url' (tela Config no app).
