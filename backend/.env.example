# Configuracao do backend (copie para .env e ajuste)
# Na feira: troque API_KEY por valor forte (openssl rand -hex 32) e copie o mesmo em firmware/include/secrets.h

DATABASE_URL=sqlite:///./aquasense.db
# DATABASE_URL para Postgres (Render): postgres://user:pass@host/db
# Chat aquarismo: opcional LLM (se vazio, usa regras locais offline)
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
API_KEY=change-me
MODEL_PATH=./ml/outputs/model.pkl
SCALER_PATH=./ml/outputs/scaler.pkl
MODEL_METADATA_PATH=./ml/outputs/metadata.json
DATASETS_DIR=./ml/datasets
ANOMALY_RETRAIN_EVERY=100
CORS_ORIGINS=https://aquasense-ai.onrender.com,http://localhost:5173,http://localhost:8000
