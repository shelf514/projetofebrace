# Configuracao do backend (copie para .env e ajuste)
# Na feira: troque API_KEY por valor forte (openssl rand -hex 32) e copie o mesmo em firmware/include/secrets.h

# Ambiente: development | production (production ativa fail-fast de API_KEY placeholder)
ENV=development
# Porta local (Render injeta PORT automaticamente)
PORT=8000
DATABASE_URL=sqlite:///./aquasense.db
# DATABASE_URL para Postgres (Render): postgresql://user:pass@host/db
# Chat aquarismo: opcional LLM (se vazio, usa regras locais offline)
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# Limite de POST /api/chat por IP/janela (60s)
CHAT_RATE_LIMIT=20
# Nivel de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
API_KEY=<openssl rand -hex 32>
MODEL_PATH=./ml/outputs/model.pkl
SCALER_PATH=./ml/outputs/scaler.pkl
MODEL_METADATA_PATH=./ml/outputs/metadata.json
DATASETS_DIR=./ml/datasets
ANOMALY_RETRAIN_EVERY=100
CORS_ORIGINS=https://aquasense-ai.onrender.com,http://localhost:5173,http://localhost:8000
# Simulador DEMO ao vivo (MOCK): 1 liga, 0 desliga — DESLIGUE em producao com dado real
DEMO_SIMULATOR_ENABLED=1
DEMO_SIMULATOR_INTERVAL_SEC=40
DEMO_SIMULATOR_ANOMALY_PROB=0.02
